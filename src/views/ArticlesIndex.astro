---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { t } from '../i18n/ui';
import { href, type Locale } from '../i18n/locales';
import { articles } from '../lib/content';
import { url } from '../lib/seo';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const list = articles(locale);
const graph = [
  {
    '@type': 'CollectionPage',
    name: t(locale, 'articles.title'),
    url: url(locale, 'articles'),
    inLanguage: locale,
    hasPart: list.map((a) => ({ '@type': 'Article', headline: a.title, url: url(locale, `articles/${a.slug}`) })),
  },
];
---

<Base locale={locale} path="articles" title={t(locale, 'articles.title')} description={t(locale, 'articles.description')} graph={graph} current="articles">
  <Breadcrumbs locale={locale} trail={[{ name: t(locale, 'nav.home'), href: href(locale) }, { name: t(locale, 'nav.articles') }]} />
  <div class="wrap prose">
    <h1>{t(locale, 'articles.title')}</h1>
    <p class="read">{t(locale, 'articles.description')}</p>
    <ul class="grid">
      {list.map((a) => (
        <li class="card link">
          <h2 style="font-size:1.2rem;margin-top:0"><a class="cover" href={href(locale, `articles/${a.slug}`)}>{a.title}</a></h2>
          <p>{a.description}</p>
          <p class="note">{t(locale, 'article.updated')}: {a.updated}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
