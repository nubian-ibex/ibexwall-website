---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { t } from '../i18n/ui';
import { href, type Locale } from '../i18n/locales';
import { COMPLIANCE, limitsOf, said, type ComplianceFramework } from '../lib/content';
import { url } from '../lib/seo';

interface Props {
  locale: Locale;
  item: ComplianceFramework;
}
const { locale, item } = Astro.props;
const title = said(item.title, locale);
const summary = said(item.summary, locale);
const limits = limitsOf(item, locale);
const path = `compliance/${item.id}`;
const graph = [
  {
    '@type': 'Article',
    headline: title,
    description: summary,
    inLanguage: locale,
    url: url(locale, path),
    dateModified: COMPLIANCE.reviewed,
    isPartOf: { '@type': 'CollectionPage', name: t(locale, 'compliance.title'), url: url(locale, 'compliance') },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'nav.home'), item: url(locale) },
      { '@type': 'ListItem', position: 2, name: t(locale, 'nav.compliance'), item: url(locale, 'compliance') },
      { '@type': 'ListItem', position: 3, name: title, item: url(locale, path) },
    ],
  },
];
---

<Base locale={locale} path={path} title={title} description={summary} graph={graph} type="article" current="compliance">
  <Breadcrumbs locale={locale} trail={[{ name: t(locale, 'nav.home'), href: href(locale) }, { name: t(locale, 'nav.compliance'), href: href(locale, 'compliance') }, { name: title }]} />
  <article class="wrap prose">
    <h1>{title}</h1>
    <p class="version">{item.version}</p>
    <p class="read">{summary}</p>
    <p class="meta">{t(locale, 'compliance.controls', { count: item.controls })} · {t(locale, 'compliance.reviewed')}: {COMPLIANCE.reviewed}</p>

    <section>
      <h2>{t(locale, 'compliance.limits')}</h2>
      <ul>
        {limits.map((limit) => <li>{limit}</li>)}
      </ul>
    </section>

    <aside class="callout">
      <p>{t(locale, 'compliance.disclaimer')}</p>
    </aside>
  </article>
</Base>
